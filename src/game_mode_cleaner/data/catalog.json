{
  "version": 1,
  "never_kill": [
    "System",
    "Registry",
    "smss.exe",
    "csrss.exe",
    "wininit.exe",
    "winlogon.exe",
    "services.exe",
    "lsass.exe",
    "svchost.exe",
    "fontdrvhost.exe",
    "dwm.exe",
    "explorer.exe",
    "Memory Compression",
    "Secure System",
    "MsMpEng.exe",
    "NisSrv.exe",
    "SecurityHealthService.exe",
    "SecurityHealthSystray.exe",
    "MsSense.exe",
    "SenseNdr.exe",
    "WmiPrvSE.exe",
    "conhost.exe",
    "sihost.exe",
    "taskhostw.exe",
    "RuntimeBroker.exe",
    "SearchHost.exe",
    "StartMenuExperienceHost.exe",
    "ShellExperienceHost.exe",
    "TextInputHost.exe",
    "ctfmon.exe",
    "audiodg.exe",
    "spoolsv.exe",
    "LsaIso.exe",
    "SgrmBroker.exe",
    "vmcompute.exe",
    "vmwp.exe",
    "GameBar.exe",
    "GameBarFTServer.exe",
    "gamingservices.exe",
    "gamingservicesnet.exe"
  ],
  "presets": {
    "light": {
      "description": "Known high-RAM interrupters only (browsers idle tabs helpers, cloud sync, RGB, updaters).",
      "groups": [
        "browsers_helpers",
        "cloud_sync",
        "rgb_overlay",
        "updaters",
        "telemetry_light"
      ]
    },
    "aggressive": {
      "description": "Broader interrupter set still excluding never-kill (adds Discord overlay helpers, indexers, launchers staying resident).",
      "groups": [
        "browsers_helpers",
        "cloud_sync",
        "rgb_overlay",
        "updaters",
        "telemetry_light",
        "chat_overlay",
        "indexers",
        "launchers_resident",
        "office_background"
      ]
    },
    "custom": {
      "description": "Only names listed in config / --exclude-file reverse: you supply the target list via --targets-file; otherwise no interrupters.",
      "groups": []
    }
  },
  "groups": {
    "browsers_helpers": {
      "label": "Browser helper / crashpad (not main browser if excluded)",
      "names": [
        "chrome_crashpad_handler.exe",
        "GoogleCrashHandler.exe",
        "GoogleCrashHandler64.exe",
        "software_reporter_tool.exe",
        "elevation_service.exe",
        "msedgewebview2.exe",
        "MicrosoftEdgeUpdate.exe",
        "browser_broker.exe",
        "firefox.exe",
        "chrome.exe",
        "msedge.exe",
        "brave.exe",
        "opera.exe",
        "vivaldi.exe"
      ]
    },
