  "restore_hints": {
    "chrome.exe": "Start Menu → Google Chrome, or: start chrome",
    "msedge.exe": "Start Menu → Microsoft Edge",
    "firefox.exe": "Start Menu → Firefox",
    "Discord.exe": "Start Menu → Discord",
